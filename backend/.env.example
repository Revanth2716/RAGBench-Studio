# RAGBench Studio Environment Configuration (Optional)
# All settings have safe local-first defaults and require zero cloud setup.

# Database file location (defaults to backend/data/ragbench.db)
# DB_PATH=data/ragbench.db

# API Host and Port (defaults to 127.0.0.1:8000)
# HOST=127.0.0.1
# PORT=8000

# Default retrieval Top-K
# DEFAULT_TOP_K=3
